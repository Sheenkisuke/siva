# ============================================================================
# Plantilla de variables de entorno para SIVA
# ----------------------------------------------------------------------------
# Copie este archivo a ".env" y ajuste los valores. El proyecto carga ".env"
# automáticamente (python-dotenv). NO suba su ".env" real al repositorio
# (ya está en .gitignore).
#
#     cp .env.example .env
# ============================================================================

# Clave secreta de Flask para firmar las cookies de sesión.
# En producción use un valor largo y aleatorio, p. ej.:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambie-esto-por-una-clave-larga-y-aleatoria

# Carpeta donde se guardan las fotos subidas y los PDFs generados.
# Por defecto: static/uploads
UPLOAD_FOLDER=static/uploads

# Umbral de similitud facial para ACEPTAR la coincidencia (0.0 - 1.0).
# Por defecto 0.85 (85%). Con la calibración anclada, la decisión de aceptar/
# rechazar la controla FACIAL_TOLERANCE; este valor solo afecta el % mostrado.
FACIAL_THRESHOLD=0.85

# Tolerancia de distancia de face_recognition: se ACEPTA si la distancia <= tolerancia.
# face_recognition recomienda 0.6, pero aquí está tuneado (0.3) para el perfil de
# demostración de V-12345678: acepta la foto idéntica (cfa8f672) y rechaza las otras
# poses (57015a8a dist 0.375, 2140a524 dist 0.417). Suba a 0.6 para uso general.
FACIAL_TOLERANCE=0.3

# Porcentaje mínimo (0-100) de píxeles claros que debe tener el fondo de la foto
# para aceptarse. Por defecto 70. Aquí en 50 para que las fotos de prueba (fondo
# ~52%) pasen la validación y la decisión la tome FACIAL_TOLERANCE. Baje a 0 para
# desactivar de hecho la exigencia de fondo claro.
FONDO_THRESHOLD=50
